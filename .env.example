# =============================================================
#  Discord-Util-Bot — copy to `.env` and fill in.
#  `.env` is gitignored. NEVER commit real values.
# =============================================================

# --- Discord ---------------------------------------------------
# Developer Portal -> Bot -> Reset Token (shown once)
DISCORD_TOKEN=your-bot-token-here
# Developer Portal -> General Information -> Application ID
DISCORD_APP_ID=000000000000000000
# Your test server's ID (Discord -> Developer Mode -> right-click server -> Copy Server ID).
# Set this in development: commands register instantly instead of taking up to an hour.
# Leave EMPTY in production to register commands globally.
DEV_GUILD_ID=

# --- GitHub App ------------------------------------------------
# Org -> Settings -> Developer settings -> GitHub Apps -> your app
GITHUB_APP_ID=000000
# The org login the bot invites people into
GITHUB_ORG=your-org-login
# From the install URL after installing the App on your org
GITHUB_INSTALLATION_ID=00000000

# Provide the private key ONE of two ways:
#  (a) path to the .pem file, stored OUTSIDE this repo, chmod 600
GITHUB_APP_PRIVATE_KEY_PATH=/absolute/path/to/app.pem
#  (b) or the PEM base64-encoded, for hosts that only support env vars:
#      base64 -i app.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY=

# --- Behavior --------------------------------------------------
# true = log the invitation that WOULD be sent, without calling GitHub.
# Use this for all Discord-side testing so you never burn real invites.
GITHUB_DRY_RUN=true

# Refuse to send more than this many invites per org per day.
# GitHub's own cap is 50/day (500 if the org is paid or >1 month old).
GITHUB_DAILY_INVITE_LIMIT=40

# Seconds a user must wait between invite requests.
INVITE_COOLDOWN_SECONDS=60

# Pending requests older than this are retired automatically, so a request a
# moderator never actioned stops blocking the person who made it. Default 7 days.
REQUEST_EXPIRY_HOURS=168

# --- Catch-up scan ---------------------------------------------
# On startup, process usernames posted while the bot was offline.
# Progress is tracked per channel by Discord message ID, so a restart resumes
# exactly where it left off. A channel seen for the first time is NOT
# back-scanned -- the cursor is set to "now" so existing history is left alone.
BACKFILL_ENABLED=true

# Ignore missed messages older than this, however far behind the cursor is.
BACKFILL_MAX_AGE_HOURS=72

# Hard ceiling on requests raised per channel per startup.
BACKFILL_MAX_PER_CHANNEL=25

# --- Runtime ---------------------------------------------------
# Where the SQLite file lives.
DATA_DIR=./data
LOG_LEVEL=info
NODE_ENV=development
